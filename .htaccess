Options -Indexes

<IfModule php_module>
    php_flag expose_php Off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.git(/|$) - [F,L,NC]
    RewriteRule (^|/)\.env(/|$) - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
    Header unset X-Powered-By
</IfModule>

<FilesMatch "(^\.|\.sql$|\.env$|^PLAN\.md$)">
    Require all denied
</FilesMatch>
