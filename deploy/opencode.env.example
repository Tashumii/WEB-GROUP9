# /etc/opencode/opencode.env  (root:root, chmod 600)
HOME=/var/lib/opencode
XDG_DATA_HOME=/var/lib/opencode/.local/share
XDG_CONFIG_HOME=/var/lib/opencode/.config
XDG_CACHE_HOME=/var/lib/opencode/.cache
# Denies every OpenCode tool (shell, file access, web). Copy deploy/opencode.json to this path.
OPENCODE_CONFIG=/etc/opencode/opencode.json
# Use the same value as OPENCODE_PASSWORD in the app's .env. Generate one with: openssl rand -hex 16
OPENCODE_SERVER_PASSWORD=CHANGE_ME
OPENCODE_DISABLE_AUTOUPDATE=true
