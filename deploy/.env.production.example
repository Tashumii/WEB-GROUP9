CI_ENVIRONMENT = production
app.baseURL = 'https://yourdomain.com/'
app.forceGlobalSecureRequests = true

# Required for 2FA (it encrypts the stored secrets). Generate once with:
#   echo "hex2bin:$(openssl rand -hex 32)"
# Never change or delete it after users have enabled 2FA. oracle-bootstrap.sh sets this for you.
encryption.key =

DB_HOST = 127.0.0.1
DB_PORT = 3306
DB_NAME = SalesDB
DB_USER = salestracker
# Use a long random password, for example: openssl rand -hex 16
DB_PASS = CHANGE_ME

OPENCODE_URL = http://127.0.0.1:4096
# Same value as OPENCODE_SERVER_PASSWORD in /etc/opencode/opencode.env
OPENCODE_PASSWORD =
OPENCODE_MODEL =
